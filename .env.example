# Server
PORT=3000
NODE_ENV=development

# Optional: OpenAI / Anthropic API key for AI-enhanced responses
# If left blank, the chatbot uses its built-in retrieval logic
OPENAI_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Analytics reset interval in hours
ANALYTICS_RESET_HOURS=24
